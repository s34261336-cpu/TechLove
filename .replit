modules = ["python-3.12", "nodejs-24"]

[workflows]
runButton = "TechLove Bot"

[[workflows.workflow]]
name = "TechLove Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-bot.sh"

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
