modules = ["python-3.12"]

[workflows]
runButton = "TechLove Bot"

[[workflows.workflow]]
name = "TechLove Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80
